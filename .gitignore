.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs
.vscode/
.idea/

# Local environment
.env
.venv/
venv/
ENV/

# Cache / temporary files
.DS_Store
Thumbs.db

# Ignore all generated data/model files by default
*.csv
*.pkl
*.joblib

# Allow data folder and its files
!data/
!data/train.csv
!data/test.csv
!data/preprocessed/
!data/preprocessed/*.csv

# Allow models folder and trained model files
!models/
!models/*.pkl
!models/*.joblib

# Allow results folder and all experiment outputs
!results/
!results/**

# Allow common report/image outputs anywhere inside project
!*.md
!*.png
!*.jpg
!*.jpeg