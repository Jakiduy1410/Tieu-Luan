# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C++ objects
*.obj
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
# Usually these files are written by a standalone easy_installer,
# for example: python2.7 -m easy_install -U setuptools
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs
.vscode/
.idea/

# Data and Models
*.csv
*.pkl
*.joblib

# Cho phép thư mục data được Git theo dõi
!data/

# Giữ lại dữ liệu gốc
!data/train.csv
!data/test.csv

# Giữ lại thư mục chứa dữ liệu đã tiền xử lý
!data/preprocessed/
!data/preprocessed/*.csv

# Cho phép thư mục models được Git theo dõi
!models/

# Giữ lại các file model đã train
!models/*.pkl
!models/*.joblib

# Nếu Lena lưu model ở thư mục khác, ví dụ output/models/
!output/
!output/models/
!output/models/*.pkl
!output/models/*.joblib

# Local environment
.env
.venv
venv/
ENV/